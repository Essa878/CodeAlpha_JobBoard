# Server port
PORT=3002

# Secret used to sign JWT tokens (change this in production!)
JWT_SECRET=dev-secret-change-me

# Token lifetime
JWT_EXPIRES_IN=7d

# Optional: override the SQLite database file location
# DB_PATH=./data/jobboard.db

# Optional: override the resume upload directory
# UPLOAD_DIR=./uploads

# Admin seed account (used by: npm run seed:admin)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@jobboard.local
ADMIN_PASSWORD=admin1234
